.boutique-page{min-height:100vh;padding:24px;background:#f4f7fb;color:#102a43;font-family:Arial,sans-serif}.top-navbar{display:flex;justify-content:space-between;align-items:center;padding:16px 24px;background:#16244b;border-radius:16px 16px 0 0}.logo{font-size:28px;font-weight:700}.logo-white{color:#fff}.logo-orange{color:#f26b14}.navbar-right{display:flex;align-items:center;gap:14px}.nav-icons{display:flex;gap:8px}.nav-icons span{width:16px;height:16px;border-radius:50%;background:#344a84;display:block}.account-btn{border:none;border-radius:10px;padding:10px 16px;background:#fff;color:#16244b;font-weight:600}.boutique-hero{background:linear-gradient(90deg,#182c66,#2449b3);color:#fff;border-radius:0 0 20px 20px;padding:24px}.hero-left{display:flex;gap:20px;align-items:center;flex-wrap:wrap}.logo-wrapper{width:120px;height:120px;background:#fff;border-radius:24px;display:grid;place-items:center;overflow:hidden}.shop-logo{width:100%;height:100%;object-fit:cover}.shop-summary{flex:1;min-width:280px}.shop-title-row{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;flex-wrap:wrap}.shop-label{display:block;margin-bottom:6px;color:#cfd7ff;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase}.shop-summary h1{margin:6px 0;color:#fff}.shop-subtitle{margin:0;color:#dce4ff}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}.hero-actions button{border:none;border-radius:999px;padding:10px 16px;font-weight:600;cursor:pointer}.follow{background:#fff;color:#1d3d91}.contact{background:transparent;border:1px solid #fff;color:#fff}.shop-meta-row{display:flex;gap:18px;flex-wrap:wrap;margin-top:16px}.meta-pill{display:flex;flex-direction:column;gap:2px}.meta-pill strong{font-size:1.1rem}.meta-pill span{color:#dce4ff;font-size:.9rem}.badges-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}.badge{display:inline-flex;align-items:center;padding:8px 12px;border-radius:999px;background:rgba(255,255,255,.16);font-size:.9rem}.badge.verified{background:rgba(255,255,255,.24)}.tabs{display:flex;gap:20px;padding:14px 20px;border-bottom:1px solid #e8edf3;background:#fff;flex-wrap:wrap}.tabs button{border:none;background:none;padding:0 4px 8px;cursor:pointer;font-size:15px;color:#334155}.tabs .active{color:#f26b14;border-bottom:3px solid #f26b14}.boutique-body{display:grid;grid-template-columns:300px 1fr;gap:24px;margin-top:24px}.boutique-sidebar{display:flex;flex-direction:column;gap:16px}.sidebar-card{background:#fff;border-radius:20px;padding:18px;box-shadow:0 10px 24px rgba(18,45,112,.06)}.sidebar-card h3{margin:0 0 12px;font-size:1rem}.info-item{display:flex;align-items:center;gap:10px;margin:10px 0;color:#555}.info-item p{margin:0}.global-rating{text-align:center}.global-rating h1{font-size:42px;margin:6px 0}.stars{color:#f7b500;letter-spacing:2px}.review-bar{display:grid;grid-template-columns:34px 1fr 28px;gap:8px;align-items:center;margin-top:8px;font-size:.9rem}.rating-track{height:8px;background:#eef2ff;border-radius:999px;overflow:hidden}.rating-fill{display:block;height:100%;background:linear-gradient(90deg,#285393,#7e92ff)}.category-list{display:flex;flex-wrap:wrap;gap:8px}.category-list button{border:none;border-radius:999px;padding:8px 12px;background:#eef3ff;cursor:pointer;color:#102a43}.category-list button.active{background:#2d57c5;color:#fff}.boutique-main{display:flex;flex-direction:column;gap:16px}.promo-header{display:flex;justify-content:space-between;gap:14px;align-items:center;flex-wrap:wrap}.promo-header h2{margin:0}.promo-header p{margin:4px 0 0;color:#64748b}.sort-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.sort-controls button{border:1px solid #d9e2ec;background:#fff;border-radius:999px;padding:8px 12px;cursor:pointer}.sort-controls button.active{background:#e8f0ff;border-color:#b7d4ff}.product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}.product-card{background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 8px 24px rgba(16,42,67,.08)}.product-image{position:relative;min-height:180px;background:#edf2ff;display:grid;place-items:center}.product-image img{width:100%;height:180px;object-fit:cover}.promo-badge,.favorite{position:absolute;top:10px}.promo-badge{left:10px;background:#f26b14;color:#fff;border-radius:999px;padding:6px 10px;font-size:.8rem}.favorite{right:10px;border:none;border-radius:50%;width:32px;height:32px;cursor:pointer}.product-body{padding:16px;display:flex;flex-direction:column;gap:10px}.product-body h3{margin:0;font-size:1rem}.category{color:#64748b;font-size:.9rem}.stars{font-size:.95rem}.price-row{display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap}.price-row strong{font-size:1rem}.price-row del{color:#94a3b8;font-size:.9rem}.card-footer{display:flex;gap:10px}.cart-btn,.view-btn{border:none;border-radius:10px;padding:10px 12px;cursor:pointer}.cart-btn{background:#1f2430;color:#fff}.view-btn{background:#eef3ff;color:#1c3866}.loading-state{padding:28px;background:#fff;border-radius:20px;text-align:center}.error-message{color:#c91c4b;font-weight:700}@media (max-width:900px){.boutique-body{grid-template-columns:1fr}.top-navbar{border-radius:0}}